# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API (or "Connect").
# The key is the public "anon" / "publishable" key — never the service_role / secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_KEY=your-anon-or-publishable-key
